# Variables de entorno de ejemplo. NO pongas secretos reales aquí.
# Copia a .env.local para desarrollo. La app debe fallar de forma explícita
# cuando falte una variable obligatoria.

# --- App ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (local por defecto; separar local/preview/producción) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role SOLO en código de servidor. Nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# --- API de búsqueda XTrace (spec 003 · contracts §6) ---
# Base URL local de la API REST (solo local, sin auth — SEC-001). Default
# http://127.0.0.1:8000; el build/CI no necesita env adicional.
NEXT_PUBLIC_XTRACE_API_URL=http://127.0.0.1:8000

# --- Tests E2E (WebdriverIO) ---
WDIO_BASE_URL=http://localhost:3000
WDIO_HEADLESS=true
E2E_TEST_USER_EMAIL=
E2E_TEST_USER_PASSWORD=
